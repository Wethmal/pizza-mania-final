<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="30dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👨‍💼 Admin Dashboard"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#2C3E50" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔"
                android:textSize="24sp"
                android:padding="8dp"
                android:background="#FFFFFF"
                android:elevation="4dp" />

        </LinearLayout>

        <!-- Welcome Message -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome back! Manage your restaurant efficiently"
            android:textSize="16sp"
            android:textColor="#7F8C8D"
            android:layout_marginBottom="25dp" />

        <!-- Dashboard Cards Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Row 1: Add New Foods -->
            <LinearLayout
                android:id="@+id/cardAddFoods"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:elevation="8dp"
                android:layout_marginBottom="16dp"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍕 Add New Foods"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#E74C3C" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add delicious items to your menu"
                        android:textSize="14sp"
                        android:textColor="#7F8C8D"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to manage →"
                        android:textSize="12sp"
                        android:textColor="#E74C3C"
                        android:textStyle="italic"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍽️"
                    android:textSize="48sp"
                    android:layout_marginStart="16dp" />

            </LinearLayout>

            <!-- Row 2: View Orders -->
            <LinearLayout
                android:id="@+id/cardViewOrders"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:elevation="8dp"
                android:layout_marginBottom="16dp"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋 View Orders"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#3498DB" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Track and manage customer orders"
                        android:textSize="14sp"
                        android:textColor="#7F8C8D"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvOrderCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12 pending orders"
                        android:textSize="12sp"
                        android:textColor="#3498DB"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"
                        android:background="#EBF3FD"
                        android:padding="4dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛒"
                    android:textSize="48sp"
                    android:layout_marginStart="16dp" />

            </LinearLayout>

            <!-- Row 3: Customer Messages -->
            <LinearLayout
                android:id="@+id/cardCustomerMessages"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:elevation="8dp"
                android:layout_marginBottom="16dp"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬 Customer Messages"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#27AE60" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Read feedback and support requests"
                        android:textSize="14sp"
                        android:textColor="#7F8C8D"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvMessageCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 unread messages"
                        android:textSize="12sp"
                        android:textColor="#27AE60"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"
                        android:background="#E8F5E8"
                        android:padding="4dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📧"
                    android:textSize="48sp"
                    android:layout_marginStart="16dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Statistics Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Quick Stats"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Total Sales -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:gravity="center"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$2,450"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#E67E22" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 Sales"
                    android:textSize="12sp"
                    android:textColor="#7F8C8D" />

            </LinearLayout>

            <!-- Total Items -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:gravity="center"
                android:layout_marginHorizontal="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="47"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#9B59B6" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍕 Items"
                    android:textSize="12sp"
                    android:textColor="#7F8C8D" />

            </LinearLayout>

            <!-- Active Users -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:gravity="center"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1,234"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1ABC9C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥 Users"
                    android:textSize="12sp"
                    android:textColor="#7F8C8D" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>