<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/message_card"
    android:padding="20dp"
    android:elevation="2dp"
    android:layout_marginTop="5dp">

    <!-- Message Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical">

        <!-- Status Indicator -->
        <View
            android:id="@+id/statusIndicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/status_new"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/txtUid"
            android:text="Customer #12345"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/txtTimestamp"
            android:text="12/09/2025 15:30"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/timestamp_bg"
            android:padding="4dp" />

    </LinearLayout>

    <!-- Message Content -->
    <TextView
        android:id="@+id/txtMessage"
        android:text="This is a sample customer message that demonstrates the new design layout."
        android:textSize="16sp"
        android:textColor="#000000"
        android:lineSpacingExtra="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />



</LinearLayout>