<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Header Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍽️ Add New Food Item 🍽️"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FF6B35"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <!-- Branch Selection Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏪 Select Branch"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:layout_marginBottom="12dp" />

            <Spinner
                android:id="@+id/spinnerBranch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:entries="@array/branches_array"
                android:background="#F8F9FA"
                android:padding="16dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Food Name Input Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍕 Food Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etFoodName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter delicious food name"
                android:inputType="text"
                android:background="#F8F9FA"
                android:padding="16dp"
                android:textSize="16sp"
                android:textColor="#2C3E50"
                android:textColorHint="#7F8C8D"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Image URL Input Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📸 Food Image"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etImageUrl"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Paste image URL here"
                android:inputType="textUri"
                android:background="#F8F9FA"
                android:padding="16dp"
                android:textSize="16sp"
                android:textColor="#2C3E50"
                android:textColorHint="#7F8C8D"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Price Input Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginBottom="24dp"
            android:elevation="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 Price"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etPrice"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter price (e.g., 12.99)"
                android:inputType="numberDecimal"
                android:background="#F8F9FA"
                android:padding="16dp"
                android:textSize="16sp"
                android:textColor="#2C3E50"
                android:textColorHint="#7F8C8D"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Add Button -->
        <Button
            android:id="@+id/btnAddFood"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✨ Add Food Item ✨"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#FF6B35"
            android:elevation="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <!-- Success Message (initially hidden) -->
        <TextView
            android:id="@+id/tvSuccessMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎉 Food item added successfully! 🎉"
            android:textSize="16sp"
            android:textColor="#27AE60"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:background="#E8F5E8"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>